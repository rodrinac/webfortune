{
  "name": "webfortune-ui",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-config.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:actions": "node scripts/check-pinned-actions.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "generate:assets": "node scripts/generate-worker-assets.mjs",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "node scripts/worker-deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "lucide": "^1.70.0"
  }
}
