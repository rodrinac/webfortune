{
  "name": "webfortune-ui",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-config.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-api.mjs",
    "generate:assets": "node scripts/generate-worker-assets.mjs",
    "worker:dev": "cd worker && wrangler dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "lucide": "^0.544.0"
  }
}
