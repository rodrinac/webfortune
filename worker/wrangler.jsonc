{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "webfortune",
  "main": "build/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // api.webfortune.app is the only live route. The commented site routes turn
  // on per-fortune link previews: the Worker then rewrites permalink HTML
  // before GitHub Pages. Leave them commented until that is wanted. A route
  // that exists only in the dashboard is removed on the next deploy, and the
  // pattern must end in /* or permalink query strings never match.
  // See docs/deployment.md.
  "routes": [
    { "pattern": "api.webfortune.app", "custom_domain": true },
    // { "pattern": "webfortune.app/*", "zone_name": "webfortune.app" },
    // { "pattern": "www.webfortune.app/*", "zone_name": "webfortune.app" },
  ],
  "build": {
    "command": "worker-build --release"
  },
  // Generated by `npm run generate:assets`. The Worker reads them through the
  // binding; running it first keeps raw asset paths off the public API.
  "assets": {
    "directory": "../build/worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Replaces the API Gateway throttle, but per client IP instead of global.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 50, "period": 10 }
    }
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://webfortune.app,https://rodrinac.github.io"
  },
  "observability": {
    "enabled": true
  }
}
